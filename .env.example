# 复制为 .env 后填入真实值；.env 已被 .gitignore 排除，不要提交

# ---------- 模型 ----------
# DeepSeek API Key（platform.deepseek.com）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# ---------- NapCat / OneBot ----------
NAPCAT_WS_URL=ws://127.0.0.1:3001
NAPCAT_ACCESS_TOKEN=
# NapCat WebUI 端口（默认 6099），token 在 NapCat 的 config/webui.json 里
NAPCAT_WEBUI_PORT=6099

# ---------- 机器人自身 ----------
BOT_QQ_ID=0
BOT_NAME=小满

# ---------- 谁能聊 ----------
# 必须用环境变量形式（带点的 qqbot.whitelist 在容器/服务里不会生效）
QQBOT_WHITELIST=100000000

# ---------- 管理后台 ----------
# 访问 http://127.0.0.1:8080 时输入的密码
ADMIN_PASSWORD=

# ---------- 语音（MiMo TTS） ----------
MIMO_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts
# 默认音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe / Milo / Dean
MIMO_TTS_VOICE=茉莉

# ---------- 本地图片预筛（可选） ----------
# imageguard 服务地址，默认本机 8081
IMAGE_GUARD_URL=http://127.0.0.1:8081
