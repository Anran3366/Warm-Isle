[Unit]
Description=Nuanyu plugin store (store-app)
After=network.target

[Service]
Type=simple
User=storeapp
Group=storeapp
WorkingDirectory=/opt/nuanyu-store/app
EnvironmentFile=/etc/nuanyu-store.env
ExecStart=/usr/bin/node /opt/nuanyu-store/app/src/server.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/nuanyu-store/data
MemoryMax=512M

[Install]
WantedBy=multi-user.target
