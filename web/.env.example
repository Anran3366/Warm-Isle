# 前端环境变量示例
# 复制为 .env.local 后按需修改

# true = 使用内置 Mock 数据（默认）；false = 请求真实后端 /api
VITE_USE_MOCK=true

# 可选：分批联调。只把列出的路径切到真实后端，其余继续走 Mock。
# 设置后优先级高于 VITE_USE_MOCK。
# 例：VITE_REAL_API=/auth,/status,/usage,/settings,/facts,/summaries,/messages,/memory,/personas,/prompt,/emoji,/logs,/push,/expression,/friends
VITE_REAL_API=
