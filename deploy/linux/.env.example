# 复制为 .env，逐项填写真实值
# 权限：chmod 600 .env

# ── 模型 ──────────────────────────────────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# 视觉模型（图片理解）
VISION_MODEL=deepseek-chat

# ── NapCat / OneBot ──────────────────────────────────
# 容器内部地址；由 docker-compose 注入，一般不用改
# 生产使用 wsproxy 缓冲代理；本地单实例可改回 ws://napcat:3001
NAPCAT_WS_URL=ws://wsproxy:3002
NAPCAT_ACCESS_TOKEN=
NAPCAT_WEBUI_PORT=6099
# 固定协议端镜像（留空 = latest，不建议生产长期使用）：
#   sudo docker inspect --format '{{index .RepoDigests 0}}' napcat
# 把输出原样填进来，NapCat 就不会被自动 pull 成新版本：
#   NAPCAT_IMAGE=mlikiowa/napcat-docker@sha256:xxxx
NAPCAT_IMAGE=

# ── 机器人自身 ────────────────────────────────────────
BOT_QQ_ID=0
BOT_NAME=小满

# 谁能聊（逗号分隔）；后台「设置」也可以改
# 注意：必须用 QQBOT_WHITELIST 这个形式，带点的 qqbot.whitelist 在容器里不会生效
QQBOT_WHITELIST=

# ── 管理后台 ──────────────────────────────────────────
ADMIN_PASSWORD=

# ── 语音（MiMo TTS）───────────────────────────────────
MIMO_API_KEY=
MIMO_TTS_MODEL=mimo-v2.5-tts
MIMO_TTS_VOICE=茉莉

# ── 图片预筛 ──────────────────────────────────────────
# Linux 没有 DirectML，必须为 0（CPU 推理）
GUARD_USE_GPU=0
GUARD_NSFW_THRESHOLD=0.85
GUARD_CLIP_THRESHOLD=0.90
GUARD_OCR_ENABLED=1
# 单张图片预筛超时（毫秒）；CPU 推理冷启动较慢，建议 20000
GUARD_TIMEOUT_MS=20000
IMAGE_GUARD_URL=http://guard:8081

# ── 元搜索（搜梗/找表情）──────────────────────────────
SEARXNG_URL=http://searxng:8080

# ── 语音识别（MiMo ASR）────────────────────────────────
MIMO_ASR_MODEL=mimo-v2.5-asr

# ── 时区 ──────────────────────────────────────────────
TZ=Asia/Shanghai

# ── 掉线告警邮件 ──────────────────────────────────────
# QQ 邮箱：设置 → 账户 → 开启 SMTP → 生成「授权码」（不是登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL=100000000@qq.com

# 外部访问地址（扫码登录用），例如 http://203.0.113.10 或 https://bot.example.com
PUBLIC_BASE_URL=http://203.0.113.10
# 断线告警接收人（主人 QQ），0 表示不发
ALERT_QQ=0

# ── 插件商店 ───────────────────────────────────────────
# 总开关：关掉后插件代码全部空实现，行为与改造前一致
PLUGIN_ENABLED=true
PLUGIN_DIR=/app/data/plugins
# 官方商店地址与公钥已写死在代码里，部署者不能改成自建商店。
# 只有商店所有者（审核方）需要配 token；其他部署留空，仍然可以「上架插件」，只是看不到审核 Tab
PLUGIN_STORE_ADMIN_TOKEN=
# 仅商店所有者：审核/发布代理走内网（可选）；其他部署不要填
# PLUGIN_STORE_ADMIN_URL=http://172.17.0.1:3500
# 发布时上报的实例名，便于审核时识别来源
PLUGIN_STORE_PUBLISHER=
# 单机并发与频控（一般不用改）
PLUGIN_MAX_SYNC_MS=20000
# L3 语义意图召回（L1/L2 没命中时才做一次 embedding，服务不可用自动降级）
PLUGIN_SEMANTIC_ENABLED=true
PLUGIN_SEMANTIC_THRESHOLD=0.80

# 可选：首次初始化页面要求输入的一次性部署令牌（不配则第一个访问者可认领）
SETUP_TOKEN=
